DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SESSION_SECRET=replace-with-a-long-random-secret
APP_ORIGIN=https://your-production-domain.example
STRIPE_SECRET_KEY=sk_test_replace_me
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Optional live-flow test override. Applies only to exact comma-separated emails.
# Stripe's minimum USD charge is 50 cents. Leave blank in normal operation.
LIVE_TEST_PRICE_CENTS=
LIVE_TEST_CUSTOMER_EMAILS=
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=bookings@your-music-life-domain.example
ZOHO_SMTP_PASSWORD=replace-with-zoho-app-password
# Optional: preferred on hosts that block SMTP. For ZeptoMail, the existing
# SMTP password/send-mail token is used automatically when the SMTP host is
# smtp.zeptomail.com, so this separate variable is only needed if desired.
ZEPTOMAIL_API_TOKEN=
EMAIL_FROM_NAME=Music Life Studios
EMAIL_FROM_ADDRESS=bookings@your-music-life-domain.example
EMAIL_REPLY_TO=bookings@your-music-life-domain.example
ADMIN_NOTIFICATION_EMAIL=bookings@your-music-life-domain.example
PUBLIC_MEDIA_ACCOUNT_ID=replace-with-r2-account-id
PUBLIC_MEDIA_BUCKET_NAME=music-life-studios-public
PUBLIC_MEDIA_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
PUBLIC_MEDIA_BASE_URL=https://media.your-music-life-domain.example
PRIVATE_MEDIA_ACCOUNT_ID=replace-with-r2-account-id
PRIVATE_MEDIA_BUCKET_NAME=music-life-studios-private
PRIVATE_MEDIA_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-scoped-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-scoped-r2-secret-access-key
